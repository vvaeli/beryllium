<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.vvaeli.beryllium</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/berylliumd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart after crashes, but not after a clean exit (e.g. during updates). -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>2</integer>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/Beryllium/stderr.log</string>
</dict>
</plist>
