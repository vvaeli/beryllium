[Unit]
Description=Beryllium proxy/VPN daemon
Documentation=https://github.com/vvaeli/beryllium
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/berylliumd
Restart=on-failure
RestartSec=2
# Creates /run/beryllium for the IPC socket.
RuntimeDirectory=beryllium
RuntimeDirectoryMode=0755
StateDirectory=beryllium
StateDirectoryMode=0700
LogsDirectory=beryllium
# TUN, routes and binding to interfaces; SETUID/SETGID to change a user's
# desktop proxy settings in their session; SYS_PTRACE to read other users'
# /proc/<pid>/exe for per-app rules.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL CAP_SYS_PTRACE
DeviceAllow=/dev/net/tun rw
# Not ProtectHome: KDE proxy settings are written to ~/.config/kioslaverc.
ProtectSystem=full
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
